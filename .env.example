# Kaithi-Drishyam Environment Configuration
# Copy this file to .env and fill in the values

# Bhashini API Configuration
KAITHI_BHASHINI_API_KEY=your_api_key_here
KAITHI_BHASHINI_API_URL=https://api.bhashini.gov.in
KAITHI_BHASHINI_UDYAT_URL=https://udyat.bhashini.gov.in/api
KAITHI_BHASHINI_TIMEOUT=30

# Model Configuration
KAITHI_CRNN_HIDDEN_SIZE=256
KAITHI_CRNN_NUM_LAYERS=2
KAITHI_CRNN_DROPOUT=0.1

# Processing Configuration
KAITHI_MAX_IMAGE_SIZE_MB=50
KAITHI_MAX_SKEW_ANGLE=15.0
KAITHI_CONFIDENCE_THRESHOLD=0.7
KAITHI_PROCESSING_TIMEOUT=30

# API Configuration
KAITHI_API_HOST=0.0.0.0
KAITHI_API_PORT=8000
KAITHI_MAX_CONCURRENT_REQUESTS=10
KAITHI_RATE_LIMIT_PER_MINUTE=60

# Device Configuration
KAITHI_USE_GPU=true
KAITHI_GPU_DEVICE_ID=0
